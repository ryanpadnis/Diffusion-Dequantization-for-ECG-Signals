# Opt-in: commit curated sample artifacts
#
# Workflow:
#   mkdir -p diffusion/commit_samples/<run_id>/
#   cp -R diffusion/results/<V?>/<run_id>/samples/ddpm/sample_0 diffusion/commit_samples/<run_id>/
#   git add diffusion/commit_samples/<run_id>/...
diffusion/commit_samples/
!diffusion/commit_samples/
!diffusion/commit_samples/**

# Override general artifact ignores within commit_samples
!diffusion/commit_samples/**/*.pt
!diffusion/commit_samples/**/*.png
!diffusion/commit_samples/**/*.jpg
!diffusion/commit_samples/**/*.jpeg
!diffusion/commit_samples/**/*.npy
!diffusion/commit_samples/**/*.npz
!diffusion/commit_samples/**/*.pkl
!diffusion/commit_samples/**/*.pickle

